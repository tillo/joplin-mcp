{
  "name": "joplin-mcp-node-tooling",
  "version": "1.0.0",
  "private": true,
  "description": "Node CLI tooling baked into the joplin-mcp image (supergateway bridge + joplin CLI). A local install so `overrides` can pin CVE-fixed transitive versions — `npm install -g` ignores overrides.",
  "dependencies": {
    "supergateway": "^4.0.0",
    "joplin": "3.7.1"
  },
  "engines": {
    "node": "^20.19.0"
  },
  "overrides": {
    "tar": "7.5.22",
    "terminal-kit": "3.1.4",
    "string-kit": "0.19.5",
    "adm-zip": "0.6.1",
    "fast-xml-parser": "5.12.0",
    "form-data": "4.0.6",
    "request": {
      "form-data": "4.0.6"
    },
    "js-yaml": "4.3.2",
    "multiparty": "4.3.1",
    "nanoid": "5.1.16",
    "sharp": "0.35.5",
    "image-size": "2.1.0",
    "linkify-it": "5.0.2",
    "follow-redirects": "1.16.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "supergateway": {
      "zod": "^4.6.6"
    }
  }
}
